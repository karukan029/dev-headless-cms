{
  "name": "dev-headless-cms",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "wrangler:deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "wrangler:login": "wrangler login",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.1.5",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.9.8",
    "hono-openapi": "^1.1.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@cloudflare/vite-plugin": "^1.2.3",
    "@valibot/to-json-schema": "^1.3.0",
    "drizzle-kit": "^0.31.7",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.1",
    "wrangler": "^4.17.0",
    "zod": "^4.1.11"
  },
  "volta": {
    "node": "22.19.0"
  }
}